{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-slicer.dev/schemas/parametric-part-v1.json",
  "title": "Agent-Slicer parametric part",
  "type": "object",
  "required": ["schema", "name", "description", "units", "operations"],
  "properties": {
    "schema": {"const": "agent-slicer-parametric-part/v1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "units": {"const": "mm"},
    "parameters": {"type": "object"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "shape"],
        "properties": {
          "operation": {"enum": ["add", "cut"]},
          "shape": {"enum": ["box", "cylinder"]},
          "center_mm": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number"}
          },
          "size_mm": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number", "exclusiveMinimum": 0}
          },
          "diameter_mm": {"type": "number", "exclusiveMinimum": 0},
          "height_mm": {"type": "number", "exclusiveMinimum": 0},
          "axis": {"enum": ["x", "y", "z"]}
        },
        "additionalProperties": false
      }
    },
    "finish": {
      "type": "object",
      "properties": {
        "fillet_mm": {"type": "number", "exclusiveMinimum": 0},
        "chamfer_mm": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
