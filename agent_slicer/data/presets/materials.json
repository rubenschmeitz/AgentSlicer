  "ifun-if3121-toughness-grey": {
    "display_name": "iFun iF3121 Toughness Grey",
    "process": "resin",
    "compatible_machines": ["elegoo-mars-3-pro"],
    "resin_slicer_profile": "elegoo-mars-3-pro-ifun-if3121-toughness-grey",
    "expected_properties": {
      "ExposureTime": 2.5,
      "BottomExposureTime": 32.0,
      "BottomLayerCount": 5
    },
    "settings": {
      "layer_height_mm": 0.05,
      "normal_exposure_s": 2.5,
      "bottom_exposure_s": 32.0,
      "bottom_layer_count": 5,
      "transition_layer_count": 5,
      "lift_distance_mm": 5.0,
      "lift_speed_mm_min": 100.0,
      "bottom_lift_speed_mm_min": 70.0,
      "retract_speed_mm_min": 150.0,
      "rest_before_lift_s": 0.5,
      "wait_after_retract_s": 0.8
    },
    "provenance": {
      "kind": "user-supplied-printer-specific-profile",
      "source": "resin_configs_mars3pro.zip",
      "source_sha256": "d7ed33267d052e2053b7d82a67747b77cdd535bb826b86e2788ab6ad6cc344c7",
      "imported": "2026-08-28"
    },
    "calibration": {
      "source_layer_heights_mm": [0.05],
      "reasons": [
        "the supplied Mars 3 Pro profile is more specific than iFun's generic 4K-mono guidance"
      ],
      "procedure": [
        "start from 2.5 s at 0.05 mm",
        "run a small exposure calibration for this bottle and ambient temperature",
        "change normal exposure in small steps before changing lift motion"
      ]
    },
    "limitations": [
      "iFun's generic manufacturer PDF lists a substantially longer 4K-mono exposure range; it is not Mars-3-Pro-specific, so that conflict is retained rather than silently replacing the supplied profile."
    ],
    "evidence": [
      {
        "url": "https://ifun3d.com/wp-content/uploads/2022/04/IF3121-High-Toughness-Resin-parametr.pdf",
        "retrieved": "2026-08-30",
        "claims": [
          "manufacturer generic IF3121 resin guidance",
          "generic 4K-mono values differ from the user-supplied Mars 3 Pro profile"
        ]
      }
    ]
  },
